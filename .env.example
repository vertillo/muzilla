# Copy to .env and fill in before `docker compose up`.
# This file configures the Docker deployment. For a bare-metal
# `muzilla serve` run, see CONTRIBUTING.md — the storage defaults are
# container paths and need overriding there, not here.

# --- Read by the application ---
# Required unless MUZILLA_AUTH__ENABLED=false (local dev only).
MUZILLA_AUTH__PASSWORD=
MUZILLA_AUTH__SESSION_SECRET=

# --- Read by docker-compose.yml only; no effect outside Docker ---
MUZILLA_PORT=
MUZILLA_BIND_ADDRESS=
MUZILLA_LIBRARY_PATH=
