{
  "arch": "__ARCH__",
  "distro": "alpine",
  "oci": {
    "image": "docker.io/library/debian:trixie-slim",
    "platform": "__PLATFORM__",
    "pullPolicy": "if-not-present"
  },
  "alpine": {
    "version": "3.23.0",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "initramfsPackages": [],
    "krunfwVersion": "v5.2.1"
  },
  "rootfs": {
    "label": "gondolin-root"
  },
  "postBuild": {
    "commands": [
      "apt-get update",
      "DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends bash build-essential ca-certificates chromium curl findutils git libchromaprint-tools npm nodejs openssh-client pkg-config procps python-is-python3 python3 python3-dev python3-pip python3-venv ripgrep",
      "curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh",
      "uv --version && python --version && node --version && npm --version && git --version",
      "rm -rf /var/lib/apt/lists/* /root/.cache"
    ]
  }
}
