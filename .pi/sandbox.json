{
  "$schema": "https://cdn.jsdelivr.net/npm/pi-sandbox@0.6.5/schema.json",
  "enabled": true,
  "permissionPromptTimeoutSeconds": 30,
  "allowBrowserProcess": false,
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": false,
    "allowUnauthenticatedSocksProxy": false,
    "allowedDomains": [
      "*"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [],
    "allowRead": [
      ".",
      "/tmp",
      "/private/tmp"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "/private/tmp"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "*.p12",
      "*.pfx",
      ".pi/settings.json",
      ".pi/sandbox.json",
      ".pi/pi-auto-review.json",
      ".pi/extensions/**",
      ".pi/agents/**",
      ".agents/**",
      "secrets/**",
      ".secrets/**"
    ]
  }
}
