{
  "$schema": "https://cdn.jsdelivr.net/npm/pi-sandbox@0.6.5/schema.json",
  "enabled": true,
  "permissionPromptTimeoutSeconds": 600,
  "allowBrowserProcess": false,
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": true,
    "allowUnauthenticatedSocksProxy": true,
    "allowedDomains": ["*"],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": ["/Users", "/home"],
    "allowRead": [".", "~/.config", "~/.local", "Library", "~/.pi/agent"],
    "allowWrite": [".", "/tmp", "~/.pi/agent"],
    "denyWrite": [".env", ".env.*", "*.pem", "*.key", ".pi/**", ".agents/**"]
  }
}
