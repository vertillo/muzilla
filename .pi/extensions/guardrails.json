{
  "$schema": "https://unpkg.com/@aliou/pi-guardrails@0.19.0/schema.json",
  "version": "0.19.0",
  "enabled": true,
  "applyBuiltinDefaults": false,
  "onboarding": {
    "completed": true,
    "completedAt": "2026-08-30T00:07:57.777Z",
    "version": "0.17.1"
  },
  "features": {
    "policies": true,
    "permissionGate": true,
    "pathAccess": true
  },
  "policies": {
    "rules": []
  },
  "pathAccess": {
    "mode": "block",
    "allowedPaths": []
  },
  "permissionGate": {
    "requireConfirmation": true,
    "autoDenyPatterns": [],
    "allowedPatterns": [],
    "patterns": [
      {
        "pattern": "(?:^|[;&|\\n])\\s*git\\b[^;&|\\n]*\\breset\\b",
        "regex": true,
        "description": "Git reset"
      },
      {
        "pattern": "(?:^|[;&|\\n])\\s*git\\b[^;&|\\n]*\\bclean\\b[^;&|\\n]*(?:--force\\b|-[A-Za-z]*f[A-Za-z]*\\b)",
        "regex": true,
        "description": "Git clean with force"
      },
      {
        "pattern": "(?:^|[;&|\\n])\\s*git\\b[^;&|\\n]*\\bcheckout\\b",
        "regex": true,
        "description": "Git checkout"
      },
      {
        "pattern": "(?:^|[;&|\\n])\\s*git\\b[^;&|\\n]*\\brestore\\b",
        "regex": true,
        "description": "Git restore"
      },
      {
        "pattern": "(?:^|[;&|\\n])\\s*git\\b[^;&|\\n]*\\brebase\\b",
        "regex": true,
        "description": "Git rebase"
      },
      {
        "pattern": "(?:^|[;&|\\n])\\s*git\\b[^;&|\\n]*\\bcommit\\b[^;&|\\n]*--amend\\b",
        "regex": true,
        "description": "Git commit amend"
      },
      {
        "pattern": "(?:^|[;&|\\n])\\s*git\\b[^;&|\\n]*\\bpush\\b[^;&|\\n]*(?:--force(?:-with-lease)?\\b|-[A-Za-z]*f[A-Za-z]*\\b)",
        "regex": true,
        "description": "Git force push"
      },
      {
        "pattern": "(?:^|[;&|\\n])\\s*git\\b[^;&|\\n]*\\bbranch\\b[^;&|\\n]*(?:-D\\b|--delete\\b[^;&|\\n]*--force\\b|--force\\b[^;&|\\n]*--delete\\b)",
        "regex": true,
        "description": "Git forced branch deletion"
      },
      {
        "pattern": "(?:^|[;&|\\n])\\s*git\\b[^;&|\\n]*\\bstash\\b[^;&|\\n]*\\b(?:drop|clear)\\b",
        "regex": true,
        "description": "Git stash deletion"
      },
      {
        "pattern": "(?:^|[;&|\\n])\\s*git\\b[^;&|\\n]*\\breflog\\b[^;&|\\n]*\\b(?:expire|delete)\\b",
        "regex": true,
        "description": "Git reflog deletion"
      }
    ]
  }
}