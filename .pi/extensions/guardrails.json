{
  "$schema": "https://unpkg.com/@aliou/pi-guardrails@0.17.1/schema.json",
  "version": "0.17.1",
  "enabled": true,
  "applyBuiltinDefaults": false,
  "onboarding": {
    "completed": true,
    "completedAt": "2026-08-30T00:07:57.777Z",
    "version": "0.17.1"
  },
  "features": {
    "policies": true,
    "permissionGate": false,
    "pathAccess": false
  },
  "policies": {
    "rules": [
      {
        "id": "mz-local-control",
        "description": "Muzilla control-plane locale: settings e sandbox",
        "patterns": [
          {
            "pattern": ".pi/settings.json"
          },
          {
            "pattern": ".pi/sandbox.json"
          },
          {
            "pattern": ".pi/pi-auto-review.json"
          }
        ],
        "protection": "readOnly",
        "onlyIfExists": false
      },
      {
        "id": "mz-local-extensions-agents",
        "description": "Muzilla extensions e agents locali (tighten-only)",
        "patterns": [
          {
            "pattern": ".pi/extensions/**"
          },
          {
            "pattern": ".pi/agents/**"
          }
        ],
        "protection": "readOnly",
        "onlyIfExists": false
      },
      {
        "id": "mz-local-secrets",
        "description": "Muzilla secrets e chiavi locali (readOnly, con fixture consentite)",
        "patterns": [
          {
            "pattern": ".env"
          },
          {
            "pattern": ".env.*"
          },
          {
            "pattern": "secrets/**"
          },
          {
            "pattern": ".secrets/**"
          },
          {
            "pattern": "*.pem"
          },
          {
            "pattern": "*.key"
          },
          {
            "pattern": "*.p12"
          },
          {
            "pattern": "*.pfx"
          }
        ],
        "protection": "readOnly",
        "onlyIfExists": false,
        "allowedPatterns": [
          {
            "pattern": ".env.example"
          },
          {
            "pattern": ".env.test"
          },
          {
            "pattern": ".pi/grill-me/**"
          },
          {
            "pattern": ".pi/agent/**"
          },
          {
            "pattern": ".pi/sandbox-exports/**"
          }
        ]
      }
    ]
  },
  "pathAccess": {
    "mode": "allow",
    "allowedPaths": [
      {
        "kind": "directory",
        "path": "/"
      }
    ]
  },
  "permissionGate": {
    "requireConfirmation": false,
    "autoDenyPatterns": [],
    "allowedPatterns": []
  }
}