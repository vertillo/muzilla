{
  "$schema": "https://unpkg.com/@aliou/pi-guardrails@0.17.1/schema.json",
  "version": "0.17.1",
  "enabled": true,
  "applyBuiltinDefaults": false,
  "onboarding": {
    "completed": true,
    "completedAt": "2026-08-30T00:07:57.777Z",
    "version": "0.17.1"
  },
  "features": {
    "policies": true,
    "permissionGate": true,
    "pathAccess": true
  },
  "policies": {
    "rules": [
      {
        "id": "mz-local-control",
        "description": "Muzilla control-plane locale readOnly",
        "patterns": [
          {
            "pattern": ".pi/settings.json"
          },
          {
            "pattern": ".pi/sandbox.json"
          },
          {
            "pattern": ".pi/pi-auto-review.json"
          }
        ],
        "protection": "readOnly",
        "onlyIfExists": false
      },
      {
        "id": "mz-local-extensions-agents",
        "description": "Muzilla extensions/agents readOnly",
        "patterns": [
          {
            "pattern": ".pi/extensions/**"
          },
          {
            "pattern": ".pi/agents/**"
          },
          {
            "pattern": ".agents/**"
          }
        ],
        "protection": "readOnly",
        "onlyIfExists": false
      },
      {
        "id": "mz-local-secrets",
        "description": "Muzilla secrets readOnly",
        "patterns": [
          {
            "pattern": ".env"
          },
          {
            "pattern": ".env.*"
          },
          {
            "pattern": "secrets/**"
          },
          {
            "pattern": ".secrets/**"
          },
          {
            "pattern": "*.pem"
          },
          {
            "pattern": "*.key"
          },
          {
            "pattern": "*.p12"
          },
          {
            "pattern": "*.pfx"
          }
        ],
        "protection": "readOnly",
        "onlyIfExists": false,
        "allowedPatterns": [
          {
            "pattern": ".env.example"
          },
          {
            "pattern": ".env.test"
          },
          {
            "pattern": ".pi/grill-me/**"
          },
          {
            "pattern": ".pi/sandbox-exports/**"
          }
        ]
      }
    ]
  },
  "pathAccess": {
    "mode": "block",
    "allowedPaths": [
      {
        "kind": "directory",
        "path": "/tmp"
      },
      {
        "kind": "directory",
        "path": "/private/tmp"
      },
      {
        "kind": "directory",
        "path": "~/.cache"
      }
    ]
  },
  "permissionGate": {
    "requireConfirmation": true,
    "autoDenyPatterns": [],
    "allowedPatterns": [],
    "patterns": [
      {
        "pattern": "(?:^|[;&|]\\s*)git\\b[^;&|\\n]*\\breset\\b",
        "regex": true,
        "description": "Git reset"
      },
      {
        "pattern": "(?:^|[;&|]\\s*)git\\b[^;&|\\n]*\\bclean\\b[^;&|\\n]*(?:--force\\b|-[A-Za-z]*f[A-Za-z]*\\b)",
        "regex": true,
        "description": "Git clean with force"
      },
      {
        "pattern": "(?:^|[;&|]\\s*)git\\b[^;&|\\n]*\\bcheckout\\b",
        "regex": true,
        "description": "Git checkout"
      },
      {
        "pattern": "(?:^|[;&|]\\s*)git\\b[^;&|\\n]*\\brestore\\b",
        "regex": true,
        "description": "Git restore"
      },
      {
        "pattern": "(?:^|[;&|]\\s*)git\\b[^;&|\\n]*\\brebase\\b",
        "regex": true,
        "description": "Git rebase"
      },
      {
        "pattern": "(?:^|[;&|]\\s*)git\\b[^;&|\\n]*\\bcommit\\b[^;&|\\n]*--amend\\b",
        "regex": true,
        "description": "Git commit amend"
      },
      {
        "pattern": "(?:^|[;&|]\\s*)git\\b[^;&|\\n]*\\bpush\\b[^;&|\\n]*(?:--force(?:-with-lease)?\\b|-[A-Za-z]*f[A-Za-z]*\\b)",
        "regex": true,
        "description": "Git force push"
      },
      {
        "pattern": "(?:^|[;&|]\\s*)git\\b[^;&|\\n]*\\bbranch\\b[^;&|\\n]*(?:-D\\b|--delete\\b[^;&|\\n]*--force\\b|--force\\b[^;&|\\n]*--delete\\b)",
        "regex": true,
        "description": "Git forced branch deletion"
      },
      {
        "pattern": "(?:^|[;&|]\\s*)git\\b[^;&|\\n]*\\bstash\\b[^;&|\\n]*\\b(?:drop|clear)\\b",
        "regex": true,
        "description": "Git stash deletion"
      },
      {
        "pattern": "(?:^|[;&|]\\s*)git\\b[^;&|\\n]*\\breflog\\b[^;&|\\n]*\\b(?:expire|delete)\\b",
        "regex": true,
        "description": "Git reflog deletion"
      }
    ]
  }
}