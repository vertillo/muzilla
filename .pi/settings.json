{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "max",
  "enabledModels": [
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-luna"
  ],
  "enableSkillCommands": true,
  "defaultTools": [
    "+codemode"
  ],
  "codemode": {
    "mode": "on"
  },
  "subagents": {
    "projectRootResolution": "git-root",
    "disableBuiltins": true,
    "defaultModel": "openai-codex/gpt-6-luna",
    "maxThinking": "high",
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "openai-codex/gpt-6.1-sol",
        "openai-codex/gpt-6-luna"
      ],
      "agents": {
        "implementer": {
          "allow": [
            "openai-codex/gpt-6.1-sol"
          ]
        },
        "oracle": {
          "allow": [
            "openai-codex/gpt-6.1-sol"
          ]
        },
        "reviewer": {
          "allow": [
            "openai-codex/gpt-6.1-sol"
          ]
        },
        "browser-tester": {
          "allow": [
            "openai-codex/gpt-6-luna"
          ]
        }
      }
    },
    "agentOverrides": {
      "planner": {
        "disabled": true
      }
    }
  }
}