# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Node / frontend
frontend/node_modules/
frontend/dist/
npm-debug.log*
# intermediate file for `npm run generate-types`, cleaned up on success and
# failure via trap — ignored defensively if a run is interrupted. Gitignore
# only treats `#` as a comment at the start of a line, so this must not be
# inline (verified:
# the previous inline form made `git check-ignore` report no match at all).
frontend/openapi.json

# Playwright E2E suite
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/

# Frontend build output landing in the Python package
src/muzilla/web/static/*
!src/muzilla/web/static/.gitkeep

# Data / runtime
data/
music/
dev-library/
tmp/
*.db
*.db-wal
*.db-shm

# Secrets / local config
.env
.env.*
!.env.example
secrets/
config.yaml
!src/muzilla/config/defaults.yaml

# Editor / OS
.DS_Store
.vscode/
.idea/

# .claude/ is deliberately TRACKED (private repo) so the harness setup —
# permission rules and the guard-rm PreToolUse hook — replicates across
# machines. Keep everything in here machine-independent: resolve paths from
# $CLAUDE_PROJECT_DIR/$HOME, never hardcode a checkout location, and never
# put credentials here.
.claude/settings.local.json

# Pi package caches
.pi/npm/
.pi/git/

# pi-subagents runtime artifacts
.pi-subagents/

# Grill Me ephemeral state
.pi/grill-me/state.json
.pi/grill-me/**.md
GRILL-ME-SANDBOX.md
GRILL-ME*.md
.pi/sandbox-exports/

pyrightconfig.json

# Keep project Agent Skill datasets versioned.
!/.agents/skills/ui-ux-pro-max/data/
!/.agents/skills/ui-ux-pro-max/data/**