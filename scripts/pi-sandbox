#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="$ROOT_DIR/docker-compose.sandbox.yml"

usage() {
    cat <<'EOF'
Usage: scripts/pi-sandbox [--rebuild] [--push] [--force] [--verify] [--] [pi arguments...]

  --rebuild  rebuild the sandbox image before starting Pi
  --push     require GITHUB_TOKEN or GH_TOKEN before starting Pi
  --force    bypass fail-closed on dirty sandbox definition (also SANDBOX_ALLOW_DIRTY=1)
  --verify   dry-run integrity checks only (no Pi launch, exit 2 on drift)
EOF
}

rebuild=0
require_push=0
force_bypass=0
verify_only=0
pi_args=()
while (($#)); do
    case "$1" in
        --rebuild)
            rebuild=1
            ;;
        --push)
            require_push=1
            ;;
        --force)
            force_bypass=1
            export SANDBOX_ALLOW_DIRTY=1
            ;;
        --verify)
            verify_only=1
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --)
            shift
            pi_args+=("$@")
            break
            ;;
        *)
            pi_args+=("$1")
            ;;
    esac
    shift
done
# ponytail: --force / SANDBOX_ALLOW_DIRTY=1 bypasses fail-closed on dirty definition (Q3)
if [[ "${SANDBOX_ALLOW_DIRTY:-0}" == 1 ]]; then
    force_bypass=1
fi

if [[ -f "$ROOT_DIR/.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "$ROOT_DIR/.env"
    set +a
fi

# Fail-closed for development: require all dev env vars (including GitHub token)
missing_vars=()
if [[ -z "${GITHUB_TOKEN:-}" && -z "${GH_TOKEN:-}" ]]; then
    missing_vars+=("GITHUB_TOKEN (or GH_TOKEN)")
fi
if [[ -z "${MUZILLA_AUTH__PASSWORD:-}" ]]; then
    missing_vars+=("MUZILLA_AUTH__PASSWORD")
fi
if [[ -z "${MUZILLA_AUTH__SESSION_SECRET:-}" ]]; then
    missing_vars+=("MUZILLA_AUTH__SESSION_SECRET")
fi
if ((${#missing_vars[@]})); then
    printf 'pi-sandbox: missing required dev env vars: %s\n' "${missing_vars[*]}" >&2
    printf 'Set them in .env (mounted RO) or export them before: GITHUB_TOKEN=... MUZILLA_AUTH__PASSWORD=... MUZILLA_AUTH__SESSION_SECRET=... make sandbox\n' >&2
    exit 2
fi

if ((require_push)) && [[ -z "${GITHUB_TOKEN:-}" && -z "${GH_TOKEN:-}" ]]; then
    printf 'pi-sandbox: --push requires GITHUB_TOKEN (or GH_TOKEN) in the launch environment.\n' >&2
    exit 2
fi

if [[ -z "${DOCKER_SOCKET:-}" ]]; then
    if [[ -S /var/run/docker.sock ]]; then
        export DOCKER_SOCKET=/var/run/docker.sock
    elif [[ -S "$HOME/.docker/run/docker.sock" ]]; then
        export DOCKER_SOCKET="$HOME/.docker/run/docker.sock"
    else
        printf 'pi-sandbox: Docker socket not found; start Docker Desktop or set DOCKER_SOCKET.\n' >&2
        exit 2
    fi
fi

if [[ ! -S "$DOCKER_SOCKET" ]]; then
    printf 'pi-sandbox: DOCKER_SOCKET is not a Unix socket: %s\n' "$DOCKER_SOCKET" >&2
    exit 2
fi

if [[ -z "${DOCKER_GID:-}" ]]; then
    # Docker Desktop remaps its host socket to root:root in the Linux VM.
    if [[ "$(uname -s)" == Darwin ]]; then
        export DOCKER_GID=0
    elif DOCKER_GID="$(stat -c '%g' "$DOCKER_SOCKET" 2>/dev/null)"; then
        export DOCKER_GID
    elif DOCKER_GID="$(stat -L -f '%g' "$DOCKER_SOCKET" 2>/dev/null)"; then
        export DOCKER_GID
    else
        printf 'pi-sandbox: cannot determine the Docker socket group: %s\n' "$DOCKER_SOCKET" >&2
        exit 2
    fi
fi

if [[ -z "${PI_AGENT_DIR:-}" ]]; then
    export PI_AGENT_DIR="$HOME/.pi/agent"
fi
if [[ ! -d "$PI_AGENT_DIR" ]]; then
    printf 'pi-sandbox: Pi agent directory not found: %s\n' "$PI_AGENT_DIR" >&2
    exit 2
fi

if [[ -z "${GIT_CONFIG_PATH:-}" ]]; then
    export GIT_CONFIG_PATH="$HOME/.gitconfig"
fi
if [[ ! -e "$GIT_CONFIG_PATH" ]]; then
    export GIT_CONFIG_PATH=/dev/null
fi

# ── Sandbox integrity checks (grill Q1-Q10, ponytail lite) ──────────────
# Protected definition paths — Q4 git diff, Q5 manifest, Q6 volumes
# generated from docker/sandbox-protected.list — single source of truth (Q14)
PROTECTED_RELS=()
if [[ -f "$ROOT_DIR/docker/sandbox-protected.list" ]]; then
    while IFS= read -r _line || [[ -n "$_line" ]]; do
        # trim leading/trailing whitespace
        _trimmed="$(echo "$_line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        [[ -z "$_trimmed" ]] && continue
        [[ "$_trimmed" == \#* ]] && continue
        PROTECTED_RELS+=("$_trimmed")
    done < "$ROOT_DIR/docker/sandbox-protected.list"
else
    PROTECTED_RELS=(
        "docker-compose.sandbox.yml"
        "docker/Dockerfile.sandbox"
        "Makefile"
        "scripts/pi-sandbox"
        "scripts/sandbox-entrypoint.sh"
        "scripts/test-sandbox.sh"
        "scripts/sandbox-docker-wrapper.sh"
        "scripts/docker-socket-proxy.py"
        ".pi/settings.json"
        "docker/pi-extensions/package.json"
        "docker/pi-extensions/package-lock.json"
        ".dockerignore"
    )
fi
SANDBOX_IMAGE="${SANDBOX_IMAGE:-muzilla-sandbox:local}"
SANDBOX_EXPORT_DIR="${SANDBOX_EXPORT_DIR:-$ROOT_DIR/.pi/sandbox-exports}"
SANDBOX_ALPINE_IMAGE="${SANDBOX_ALPINE_IMAGE:-alpine:3.21@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d}"
drift_msgs=()
# Q4 — git diff for protected files (fail-closed, Q3 bypass via --force)
if command -v git >/dev/null 2>&1 && git -C "$ROOT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    dirty=""
    # staged + unstaged vs HEAD; untracked protected files also count
    if git -C "$ROOT_DIR" diff --name-only HEAD -- "${PROTECTED_RELS[@]}" 2>/dev/null | grep -q .; then
        dirty="$(git -C "$ROOT_DIR" diff --name-only HEAD -- "${PROTECTED_RELS[@]}" 2>/dev/null | tr '\n' ' ')"
    fi
    if git -C "$ROOT_DIR" diff --cached --name-only HEAD -- "${PROTECTED_RELS[@]}" 2>/dev/null | grep -q .; then
        staged="$(git -C "$ROOT_DIR" diff --cached --name-only HEAD -- "${PROTECTED_RELS[@]}" 2>/dev/null | tr '\n' ' ')"
        dirty="${dirty} ${staged}"
    fi
    # untracked protected files (not ignored)
    untracked="$(git -C "$ROOT_DIR" ls-files --others --exclude-standard -- "${PROTECTED_RELS[@]}" 2>/dev/null | tr '\n' ' ')"
    if [[ -n "${untracked// /}" ]]; then
        dirty="${dirty} ${untracked}"
    fi
    dirty="$(echo "$dirty" | xargs 2>/dev/null || true)"
    # Q1/Q2 workspace warn — non-blocking for src/frontend etc (ponytail: counts without spamming)
    all_dirty="$(git -C "$ROOT_DIR" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
    protected_count="$(echo "$dirty" | wc -w | tr -d ' ')"
    if [[ -n "$all_dirty" && "$all_dirty" != "0" && "${protected_count:-0}" == "0" ]]; then
        ws_files="$(git -C "$ROOT_DIR" status --porcelain 2>/dev/null | head -n 5 | tr '\n' ' ')"
        printf '\033[33msandbox: workspace dirty (non-bloccante): %s... (%s files) — git status per dettagli\033[0m\n' "$ws_files" "$all_dirty" >&2
        drift_msgs+=("workspace dirty (non-bloccante): $all_dirty files")
    fi
    if [[ -n "$dirty" ]]; then
        if ((force_bypass)); then
            drift_msgs+=("definition dirty (bypassed via --force/SANDBOX_ALLOW_DIRTY=1): $dirty")
            printf '\033[33msandbox: definition dirty bypassed: %s\033[0m\n' "$dirty" >&2
            git -C "$ROOT_DIR" diff --stat HEAD -- "${PROTECTED_RELS[@]}" 2>/dev/null | head -n 20 >&2 || true
        else
            printf '\033[33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n' >&2
            printf '\033[33msandbox: definizione sandbox modificata (non committata) — fail-closed\033[0m\n' >&2
            printf 'File sporchi: %s\n' "$dirty" >&2
            git -C "$ROOT_DIR" diff --stat HEAD -- "${PROTECTED_RELS[@]}" 2>/dev/null | head -n 30 >&2 || true
            git -C "$ROOT_DIR" diff HEAD -- "${PROTECTED_RELS[@]}" 2>/dev/null | head -n 80 >&2 || true
            printf '\nIstruzioni:\n' >&2
            printf '  git diff HEAD -- %s    # rivedi\n' "${PROTECTED_RELS[0]}" >&2
            printf '  git commit -m "sandbox: ..."       # committa per sbloccare definitivamente (Q3)\n' >&2
            printf '  git restore --staged --worktree -- %s  # oppure ripristina\n' "$dirty" >&2
            printf '  SANDBOX_ALLOW_DIRTY=1 make sandbox           # bypass WIP via env (loggato)\n' >&2
            printf '  make sandbox ARGS="--force"                 # oppure via flag\n' >&2
            printf '\033[33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n' >&2
            exit 2
        fi
    fi
fi
# Q8 — .env warn redatto, mai block
if [[ -f "$ROOT_DIR/.env" ]]; then
    env_hash="$(sha256sum "$ROOT_DIR/.env" 2>/dev/null | cut -d' ' -f1 || true)"
    env_last_file="$SANDBOX_EXPORT_DIR/.env.sha256"
    env_last=""
    [[ -f "$env_last_file" ]] && env_last="$(cat "$env_last_file" 2>/dev/null || true)"
    if [[ -n "$env_hash" && "$env_hash" != "$env_last" ]]; then
        if [[ -n "$env_last" ]]; then
            # redacted: count vars, never print values
            env_vars="$(grep -cE '^[A-Z_]+__' "$ROOT_DIR/.env" 2>/dev/null || echo '?')"
            drift_msgs+=(".env changed (redacted, ~${env_vars} vars, ${env_last:0:8}..->${env_hash:0:8}..)")
            printf '\033[33msandbox: .env changed since last run (redacted, ~%s vars, %s..->%s..)\033[0m\n' "$env_vars" "${env_last:0:8}" "${env_hash:0:8}" >&2
        fi
        mkdir -p "$(dirname "$env_last_file")"
        printf '%s\n' "$env_hash" >"$env_last_file"
    fi
fi
# Q5 — host manifest (same files as Dockerfile) for image staleness (ponytail: hash-only, repo-relative, sort for determinism)
compute_host_manifest() {
    local hash_input=""
    local f h
    for f in "${PROTECTED_RELS[@]}"; do
        if [[ -f "$ROOT_DIR/$f" ]]; then
            h="$(sha256sum "$ROOT_DIR/$f" 2>/dev/null | cut -d' ' -f1)"
            hash_input+="${f}:${h}"$'\n'
        fi
    done
    # also include e2e lock if present (part of gate)
    if [[ -f "$ROOT_DIR/e2e/package-lock.json" ]]; then
        h="$(sha256sum "$ROOT_DIR/e2e/package-lock.json" 2>/dev/null | cut -d' ' -f1)"
        hash_input+="e2e/package-lock.json:${h}"$'\n'
    fi
    printf '%s' "$hash_input" | sort | sha256sum | cut -d' ' -f1
}
if (( ! rebuild )); then
    host_manifest="$(compute_host_manifest)"
    image_manifest=""
    image_exists=0
    if docker image inspect "$SANDBOX_IMAGE" >/dev/null 2>&1; then
        image_exists=1
        # try label first, then file inside image
        image_manifest="$(docker inspect --format '{{ index .Config.Labels "muzilla.manifest" }}' "$SANDBOX_IMAGE" 2>/dev/null || true)"
        if [[ -z "$image_manifest" || "$image_manifest" == "<no value>" ]]; then
            image_manifest="$(docker run --rm --entrypoint cat "$SANDBOX_IMAGE" /opt/pi-agent/.sandbox-manifest 2>/dev/null | tr -d ' \n' || true)"
        fi
        # fallback to old baked-version single hash (pre-manifest images)
        if [[ -z "$image_manifest" ]]; then
            image_manifest="$(docker run --rm --entrypoint cat "$SANDBOX_IMAGE" /opt/pi-agent/.sandbox-baked-version 2>/dev/null | tr -d ' \n' || true)"
        fi
    fi
    # Q10 — auto-rebuild if stale or missing, Q9 only on drift prints yellow block
    if [[ "$image_exists" == 0 ]]; then
        drift_msgs+=("image missing ($SANDBOX_IMAGE), rebuilding...")
        printf '\033[33msandbox: image %s mancante — rebuild automatico...\033[0m\n' "$SANDBOX_IMAGE" >&2
        if ((verify_only)); then
            printf 'sandbox --verify: image mancante, rebuild necessario\n' >&2
            exit 2
        fi
        SANDBOX_MANIFEST="$host_manifest" docker compose -f "$COMPOSE_FILE" build sandbox
    elif [[ -n "$host_manifest" && -n "$image_manifest" && "$host_manifest" != "$image_manifest" ]]; then
        # Heuristic: old images have short baked-version (PI_VERSION-hash), not full manifest — treat as stale
        # host_manifest is 64 hex, baked-version is like "0.84.3-abc..." — not equal → rebuild
        drift_msgs+=("image stale (host ${host_manifest:0:8}.. != image ${image_manifest:0:8}..), rebuilding...")
        printf '\033[33msandbox: image stale (host %s.. != image %s..) — rebuild automatico...\033[0m\n' "${host_manifest:0:8}" "${image_manifest:0:8}" >&2
        if ((verify_only)); then
            printf 'sandbox --verify: image stale, rebuild necessario\n' >&2
            exit 2
        fi
        SANDBOX_MANIFEST="$host_manifest" docker compose -f "$COMPOSE_FILE" build sandbox
        # Q6 — cache volumes are disposable: reset silently after image rebuild
        for vol in sandbox-uv-cache sandbox-npm-cache sandbox-pi-cache sandbox-playwright-cache; do
            docker volume rm "muzilla-${vol}" >/dev/null 2>&1 || true
        done
        if [[ ${#drift_msgs[@]} -gt 0 ]]; then
            printf '\033[33msandbox: cache volumes resettati (ricreabili al prossimo avvio)\033[0m\n' >&2
        fi
    elif ((verify_only)) && [[ "$image_exists" == 1 ]]; then
        : # verify ok, no rebuild needed
    fi
fi
# Q6 — pi-home volume taint: canonical marker is manifest only (ponytail: single source of truth)
# Runs also in --verify (reports drift without deleting)
if docker volume inspect muzilla-sandbox-pi-home >/dev/null 2>&1; then
        vol_manifest="$(docker run --rm --mount type=volume,src=muzilla-sandbox-pi-home,dst=/vol,readonly "$SANDBOX_ALPINE_IMAGE" sh -ec 'cat /vol/.pi/agent/.sandbox-manifest 2>/dev/null || true' 2>/dev/null | tr -d ' \n' || true)"
    img_manifest_vol="$(docker run --rm --entrypoint cat "$SANDBOX_IMAGE" /opt/pi-agent/.sandbox-manifest 2>/dev/null | tr -d ' \n' || true)"
    if [[ -n "$vol_manifest" && -n "$img_manifest_vol" && "$vol_manifest" != "$img_manifest_vol" ]]; then
        if ((verify_only)); then
            drift_msgs+=("pi-home tainted (vol ${vol_manifest:0:8}.. != img ${img_manifest_vol:0:8}.., verify only)")
            printf '\033[33msandbox --verify: pi-home tainted (vol %s.. != img %s..)\033[0m\n' "${vol_manifest:0:8}" "${img_manifest_vol:0:8}" >&2
        else
            ts="$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null || date +%Y%m%d%H%M%S)"
            backup_dir="$SANDBOX_EXPORT_DIR"
            mkdir -p "$backup_dir"
            backup_file="$backup_dir/pi-home-tainted-${ts}.tar.gz"
            printf '\033[33msandbox: pi-home volume tainted (vol %s.. != img %s..) — backup e reset...\033[0m\n' "${vol_manifest:0:8}" "${img_manifest_vol:0:8}" >&2
            # fail-closed if backup fails — do not delete volume without valid backup
            set +e
            docker run --rm \
                --mount type=volume,src=muzilla-sandbox-pi-home,dst=/vol,readonly \
                --mount type=bind,src="$backup_dir",dst=/out \
                "$SANDBOX_ALPINE_IMAGE" sh -ec "tar -C /vol -czf /out/$(basename "$backup_file") . && sha256sum /out/$(basename "$backup_file") | sed 's#/out/##' > /out/$(basename "$backup_file").sha256 && cd /out && sha256sum -c $(basename "$backup_file").sha256" > /tmp/pi-home-backup.log 2>&1
            backup_rc=$?
            set -e
            if [[ $backup_rc -ne 0 || ! -f "$backup_file" ]]; then
                printf '\033[31msandbox: backup pi-home fallito (rc %s) — volume NON cancellato, vedi /tmp/pi-home-backup.log\033[0m\n' "$backup_rc" >&2
                cat /tmp/pi-home-backup.log >&2 || true
                drift_msgs+=("pi-home backup failed, volume preserved")
            else
                if ! sha256sum -c "$backup_file.sha256" >/dev/null 2>&1 && ! docker run --rm --mount type=bind,src="$backup_dir",dst=/in,readonly "$SANDBOX_ALPINE_IMAGE" sh -ec "cd /in && sha256sum -c $(basename "$backup_file").sha256" >/dev/null 2>&1; then
                    printf '\033[31msandbox: backup checksum verifica fallita — volume NON cancellato\033[0m\n' >&2
                    drift_msgs+=("pi-home backup checksum failed, volume preserved")
                else
                    drift_msgs+=("pi-home tainted, backup: $backup_file")
                    printf '\033[33msandbox: backup pi-home: %s\033[0m\n' "$backup_file" >&2
                    docker volume rm muzilla-sandbox-pi-home >/dev/null 2>&1 || {
                        printf '\033[31msandbox: volume rm fallito\033[0m\n' >&2
                    }
                    ls -t "$backup_dir"/pi-home-tainted-*.tar.gz 2>/dev/null | tail -n +6 | xargs rm -f 2>/dev/null || true
                    ls -t "$backup_dir"/pi-home-tainted-*.tar.gz.sha256 2>/dev/null | tail -n +6 | xargs rm -f 2>/dev/null || true
                fi
            fi
        fi
    fi
fi
# Q9 — drift observability: if any drift was auto-healed, print summary (yellow) — otherwise silent
if ((${#drift_msgs[@]})); then
    printf '\033[33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n' >&2
    printf '\033[33msandbox drift auto-healed:\033[0m\n' >&2
    for m in "${drift_msgs[@]}"; do printf '  • %s\n' "$m" >&2; done
    printf '\033[33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n' >&2
fi
if ((verify_only)); then
    if ((${#drift_msgs[@]})); then
        printf 'sandbox --verify: drift rilevato (%d voci)\n' "${#drift_msgs[@]}" >&2
        exit 2
    else
        printf 'sandbox --verify: ok\n' >&2
        exit 0
    fi
fi
# ── end integrity checks ───────────────────────────────────────────────

cd "$ROOT_DIR"
compose=(docker compose -f "$COMPOSE_FILE")
if ((rebuild)); then
    host_manifest_rebuild="$(compute_host_manifest)"
    SANDBOX_MANIFEST="$host_manifest_rebuild" "${compose[@]}" build sandbox
fi

if ((${#pi_args[@]})); then
    exec "${compose[@]}" run --rm sandbox pi "${pi_args[@]}"
else
    exec "${compose[@]}" run --rm sandbox pi
fi
