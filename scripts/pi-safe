#!/usr/bin/env bash
set -euo pipefail

SAFE_AGENT_DIR="${PI_SAFE_AGENT_DIR:-$HOME/.pi/agent-gondolin-safe}"
CACHE_ROOT="${PI_SAFE_CACHE_ROOT:-$HOME/.cache/pi-safe-gondolin}"

fail() {
  printf 'pi-safe: %s\n' "$*" >&2
  exit 1
}

for command in git node pi; do
  command -v "$command" >/dev/null 2>&1 || fail "$command is required"
done

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || \
  fail 'run pi-safe from inside a Git repository'
cd "$repo_root"

case "$(uname -m)" in
  arm64|aarch64) arch="aarch64" ;;
  x86_64|amd64) arch="x86_64" ;;
  *) fail "unsupported host architecture: $(uname -m)" ;;
esac

assets_dir="$CACHE_ROOT/assets-$arch"
[[ -f "$assets_dir/manifest.json" ]] || \
  fail "Gondolin guest image is missing; run ${repo_root}/scripts/pi-safe-setup (or the setup script from the repository that owns pi-safe)"
[[ -f "$SAFE_AGENT_DIR/settings.json" ]] || \
  fail "safe Pi profile is missing; run scripts/pi-safe-setup first"

# Pi extensions execute on the host. Safe mode therefore refuses unreviewed
# project-local executable resources instead of assuming Gondolin contains them.
if [[ "${PI_SAFE_ALLOW_PROJECT_EXTENSIONS:-0}" != "1" ]]; then
  if [[ -d "$repo_root/.pi/extensions" ]]; then
    unexpected="$(find "$repo_root/.pi/extensions" -mindepth 1 -maxdepth 1 \
      ! -name gondolin-safe -print -quit 2>/dev/null || true)"
    [[ -z "$unexpected" ]] || fail \
      "unreviewed project extension would run on the host: $unexpected (set PI_SAFE_ALLOW_PROJECT_EXTENSIONS=1 only after review)"
  fi

  if [[ -f "$repo_root/.pi/settings.json" ]]; then
    node - "$repo_root/.pi/settings.json" <<'NODE' || exit $?
const fs = require("node:fs");
const file = process.argv[2];
const settings = JSON.parse(fs.readFileSync(file, "utf8"));
const executable = [];
if (Array.isArray(settings.packages) && settings.packages.length) executable.push("packages");
if (Array.isArray(settings.extensions) && settings.extensions.length) executable.push("extensions");
if (executable.length) {
  console.error(`pi-safe: project settings enable host-side executable resources: ${executable.join(", ")}`);
  console.error("pi-safe: audit them first or set PI_SAFE_ALLOW_PROJECT_EXTENSIONS=1 deliberately");
  process.exit(1);
}
NODE
  fi
fi

export PI_CODING_AGENT_DIR="$SAFE_AGENT_DIR"
export PI_GONDOLIN_SAFE=1
export GONDOLIN_GUEST_DIR="$assets_dir"
export GIT_TERMINAL_PROMPT=0

# Default guest egress is intentionally narrow and download-oriented. Override
# explicitly for a project that needs additional package registries/docs hosts.
export PI_GONDOLIN_ALLOWED_HOSTS="${PI_GONDOLIN_ALLOWED_HOSTS:-pypi.org,files.pythonhosted.org,registry.npmjs.org}"

# Preserve commit attribution without exposing the host Git config to the VM.
git_name="$(git config --get user.name 2>/dev/null || true)"
git_email="$(git config --get user.email 2>/dev/null || true)"
if [[ -n "$git_name" ]]; then
  export GIT_AUTHOR_NAME="$git_name" GIT_COMMITTER_NAME="$git_name"
fi
if [[ -n "$git_email" ]]; then
  export GIT_AUTHOR_EMAIL="$git_email" GIT_COMMITTER_EMAIL="$git_email"
fi

origin="$(git remote get-url origin 2>/dev/null || true)"
case "$origin" in
  git@github.com:*|ssh://git@github.com/*)
    if [[ -z "${SSH_AUTH_SOCK:-}" ]]; then
      printf 'pi-safe: origin uses GitHub SSH but SSH_AUTH_SOCK is unset; commit works, fetch/push will be blocked.\n' >&2
    fi
    ;;
  https://github.com/*|http://github.com/*)
    printf 'pi-safe: origin uses HTTPS. Safe autonomous push is intentionally disabled; use a GitHub SSH origin.\n' >&2
    ;;
  "")
    printf 'pi-safe: no origin remote; Git commit works, push is unavailable.\n' >&2
    ;;
  *)
    printf 'pi-safe: non-GitHub origin detected; Gondolin outbound SSH policy will not authorize it.\n' >&2
    ;;
esac

# Normal `pi` keeps the user's full extension set. Only this command switches to
# the minimal safe agent directory; child Pi processes inherit the environment.
exec pi "$@"
